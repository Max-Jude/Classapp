# ClassFlow Environment Configuration
# Note: In Google AI Studio, Firebase is automatically configured via firebase-applet-config.json.
# When deploying externally to Netlify or running locally without firebase-applet-config.json,
# you can optionally uncomment and set these variables in .env.local or Netlify Environment Variables:
#
# VITE_FIREBASE_API_KEY="YOUR_FIREBASE_WEB_API_KEY"
# VITE_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
# VITE_FIREBASE_PROJECT_ID="your-project-id"
# VITE_FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"
# VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_MESSAGING_SENDER_ID"
# VITE_FIREBASE_APP_ID="YOUR_FIREBASE_WEB_APP_ID"
# VITE_FIREBASE_DATABASE_ID="your-firestore-database-id"
